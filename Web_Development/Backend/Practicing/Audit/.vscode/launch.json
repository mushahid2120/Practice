{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": [
        "<node_internals>/**"
      ],

      "runtimeArgs": [
        "--experimental-loader=@opentelemetry/instrumentation/hook.mjs",
        "--import",
        "./instrumentation.mjs"
      ],

      "program": "${workspaceFolder}/app_logger.js"
    }
  ]
}